{
  "name": "doubao-account-manager",
  "version": "0.1.38",
  "description": "豆包多账号隔离登录、额度调度和本地视频生成接口服务",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all -p dev:renderer dev:electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 tsc -p tsconfig.electron.json && electron .",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:watermark": "npm run build && node --test tests/watermark.test.mjs",
    "verify:mac": "codesign --verify --deep --strict --verbose=4 'release/mac-arm64/豆包账号池接口服务.app'",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.4.3",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "cross-env": "^7.0.3",
    "electron": "^36.5.0",
    "electron-builder": "^25.1.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.local.doubao-account-manager.latest",
    "productName": "豆包账号池接口服务",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "豆包账号池"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
